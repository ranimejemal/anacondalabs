{
  "openapi": "3.0.0",
  "info": {
    "title": "Sample Marketplace API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "hunter2"
          }
        }
      },
      "DealUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Updated deal title"
          },
          "amount": {
            "type": "number",
            "example": 1200
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "newuser@example.com"
          },
          "name": {
            "type": "string",
            "example": "Test User"
          }
        }
      },
      "FetchAvatarRequest": {
        "type": "object",
        "properties": {
          "avatar_url": {
            "type": "string",
            "example": "https://example.com/default-avatar.png"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "Authenticate a user",
        "security": [],
        "tags": [
          "auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Get a user profile by ID",
        "tags": [
          "users"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/deals/{id}": {
      "get": {
        "summary": "Get a deal by ID",
        "tags": [
          "deals"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "put": {
        "summary": "Update a deal",
        "tags": [
          "deals"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DealUpdate"
              }
            }
          }
        }
      }
    },
    "/deals/search": {
      "get": {
        "summary": "Search deals",
        "tags": [
          "deals"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/admin/users": {
      "get": {
        "summary": "List all users (admin only)",
        "tags": [
          "admin"
        ]
      }
    },
    "/users": {
      "post": {
        "summary": "Create a user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "users"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        }
      }
    },
    "/fetch-avatar": {
      "post": {
        "summary": "Fetch and cache a user's avatar image from a URL",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "tags": [
          "users"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FetchAvatarRequest"
              }
            }
          }
        }
      }
    }
  }
}
