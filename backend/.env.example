# AegisLab backend — environment variables for AI features
# ============================================================
# Copy this file to `.env` in the backend/ folder (or export these in your
# shell / conda env) and fill in real values. Without these set, the app
# still works fully for scanning — only the AI suggestion / auto-fix
# buttons will show a "not configured" message instead of erroring.
#
# These are NOT loaded automatically by uvicorn — either:
#   a) export them in the shell that launches the app (see scripts/), or
#   b) add `from dotenv import load_dotenv; load_dotenv()` at the top of
#      main.py and `pip install python-dotenv` (already a transitive dep
#      of uvicorn[standard], so this just needs the two-line addition).

# --- Supabase (https://supabase.com — free tier is enough) ---
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Project Settings -> API -> service_role key. SERVER-SIDE ONLY.
# Never put this in frontend code or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Anthropic (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional override, defaults to claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- AI rate limiting (optional, sensible defaults if unset) ---
# Per-user daily caps so a single account can't run unbounded Anthropic
# spend. auto-fix is capped lower since it's a much more expensive call
# (whole file + 4000 tokens) than a text suggestion.
AI_SUGGEST_DAILY_LIMIT=40
AI_AUTOFIX_DAILY_LIMIT=15

# --- Launch flag: premium free for everyone (temporary) ---
# While pricing isn't finalized, every signed-in user gets premium access
# for free — the Stripe integration below stays fully wired and ready, this
# just skips the paywall at the single point is_premium is resolved. Flip
# to false (or remove) whenever you're ready to actually start charging.
AEGISLAB_PREMIUM_FREE_FOR_ALL=true

# --- GitHub "Connect account" (github.com/settings/developers -> New OAuth App) ---
# Homepage URL: anything (e.g. your repo URL). Authorization callback URL
# MUST be exactly:  aegislab://oauth/callback
# Client ID is not secret; Client Secret is server-side only, same rule as
# every other secret in this file.
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
# Only change this if you also change the callback URL registered on the
# GitHub OAuth App above — they must match exactly.
GITHUB_OAUTH_REDIRECT_URI=aegislab://oauth/callback

# --- Stripe (https://dashboard.stripe.com) ---
# Use TEST MODE keys (sk_test_..., whsec_test from the CLI or a test-mode
# webhook endpoint) until you're actually ready to go live in Sprint 6.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
# From Stripe CLI (`stripe listen`) in dev, or the webhook endpoint's
# signing secret in the dashboard for a deployed backend.
STRIPE_WEBHOOK_SECRET=whsec_...
# Only needed if the backend isn't on the default port/host.
AEGISLAB_BACKEND_BASE_URL=http://127.0.0.1:8765
